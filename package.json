{
  "name": "adplix-media",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "marketing:test:e2e": "node tests/marketing.e2e.mjs",
    "portal:build": "vite build --outDir .portal-dist",
    "portal:dev": "wrangler dev --config wrangler.portal.toml --local --port 8787",
    "portal:migrate": "wrangler d1 migrations apply adplix-portal-local --config wrangler.portal.toml --local",
    "portal:bootstrap": "node scripts/portal-bootstrap.mjs",
    "portal:test:e2e": "node tests/portal.e2e.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "vite": "^7.3.7",
    "wrangler": "^4.148.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
